# Copiar como .env dentro de Backend/ y completar solo si se usan servicios externos.

# PostgreSQL (opcional; si no está disponible, el backend intenta usar SQLite local).
# DATABASE_URL=postgresql://usuario:password@host:5432/spherex_db
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=spherex_db
# POSTGRES_PORT=5432

# Redis (opcional; si no está disponible, se usa caché en memoria).
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

PUBLIC_BASE_URL=http://localhost:8000
# Orígenes exactos separados por comas; agrega aquí el dominio frontend de producción.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8443
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
SPHEREX_RAW_DIR=./data/raw/spherex
SPHEREX_PROCESSED_DIR=./data/processed/spherex
SPHEREX_MANIFEST_PATH=./data/processed/spherex/fits-manifest.json
SPHEREX_CONSUMERS_PATH=./fits-consumers.json
